# Trading mode: "paper" (default, safe) or "live"
TRADING_MODE=paper

# IB Gateway credentials
TWS_USERID=your_ib_username
TWS_PASSWORD=your_ib_password

# Database
POSTGRES_PASSWORD=trading
TRADING__DATABASE__URL=postgresql+asyncpg://trading:trading@localhost:5432/trading

# Redis
TRADING__REDIS__URL=redis://localhost:6379/0

# Anthropic API key (required for AI agent pipeline)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Finnhub API key (optional, for earnings calendar)
FINNHUB_API_KEY=

# ── VPS / Production only ────────────────────────────────────────
# Your VPS public IP or domain (used for dashboard CORS and URLs)
# VPS_HOST=203.0.113.50
# DASHBOARD_API_PORT=8000
# DASHBOARD_UI_PORT=3000
