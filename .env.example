# Trading mode: "paper" (default, safe) or "live"
TRADING_MODE=paper

# IB Gateway credentials
TWS_USERID=your_ib_username
TWS_PASSWORD=your_ib_password

# Database
POSTGRES_PASSWORD=trading
TRADING__DATABASE__URL=postgresql+asyncpg://trading:trading@localhost:5432/trading

# Redis
TRADING__REDIS__URL=redis://localhost:6379/0
