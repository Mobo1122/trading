# Trading mode: "paper" (default, safe) or "live"
TRADING_MODE=paper

# IB Gateway credentials
TWS_USERID=your_ib_username
TWS_PASSWORD=your_ib_password

# Database
POSTGRES_PASSWORD=trading
TRADING__DATABASE__URL=postgresql+asyncpg://trading:trading@localhost:5432/trading

# Redis
TRADING__REDIS__URL=redis://localhost:6379/0

# Anthropic API key (required for AI agent pipeline)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Finnhub API key (optional, for earnings calendar)
FINNHUB_API_KEY=

# ── VPS / Production only ────────────────────────────────────────
# Public hostname for the dashboard (used by Caddy for HTTPS and
# by the dashboard API for CORS). Must point a DNS A record to your
# VPS for Let's Encrypt cert issuance to succeed.
# PUBLIC_HOST=trading.example.com

# Basic auth credentials for the dashboard. The hash is bcrypt;
# generate with: docker exec trading-caddy-1 caddy hash-password
# BASIC_AUTH_USER=admin
# BASIC_AUTH_HASH=$2a$14$...
